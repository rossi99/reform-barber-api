# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/reform_barber?sslmode=disable

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_secret

# Server
API_PORT=8080

# Storage — set to "r2" in production
STORAGE_BACKEND=local          # local | r2
UPLOADS_DIR=./uploads          # only used when STORAGE_BACKEND=local

# Cloudflare R2 (only required when STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=reform-barber
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# Email — Resend (optional: omit to disable email notifications)
RESEND_API_KEY=
EMAIL_FROM=bookings@reformbarber.co.uk

# SMS — Twilio (optional: omit to disable SMS notifications)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+44...
